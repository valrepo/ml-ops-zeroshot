# Copy to .env and adjust:   cp .env.example .env
# LOCAL DEVELOPMENT ONLY — not production-safe. Never commit .env.

# --- Application --------------------------------------------------------------
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# json (machine-readable) or console (human-readable)
LOG_FORMAT=console
MAX_INPUT_CHARS=5000
MAX_LOADED_MODELS=1
# cpu (default, used in CI/Docker) or mps (opt-in on Apple Silicon; may change scores slightly)
INFERENCE_DEVICE=cpu

# --- Models & Hugging Face ----------------------------------------------------
MODEL_DIR=./models
HF_HOME=./.cache/huggingface
# Only needed for gated/private models. Leave empty for the two default models.
HF_TOKEN=
# TRANSFORMERS_CACHE=  (deprecated, ignored — see docs/adr/0001-hf-home-instead-of-transformers-cache.md)
MODELS_FILE=./configs/models.yaml
LABEL_SETS_FILE=./data/label_sets.yaml
LABEL_SETS_SEED_FILE=./configs/labels.yaml

# --- MinIO (the app's credentials MUST equal the server's root credentials) ---
# Host-run app talks to the published port; inside Compose the app uses minio:9000.
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin-local
MINIO_SECRET_KEY=change-me-local-only
MINIO_SECURE=false
# Required name zeroshot_learning_output is rejected by MinIO (S3 naming) — see docs/adr/0002-bucket-name-hyphens.md
MINIO_BUCKET=zeroshot-learning-output

# --- Docker Compose only (not read by the Python app) -------------------------
MINIO_ROOT_USER=minioadmin-local
# MinIO requires >= 8 characters
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
APP_PORT=8502
